{
  "enableAllProjectMcpServers": true,
  "enabledMcpjsonServers": ["pachinko"],
  "permissions": {
    "allow": [
      "mcp__pachinko__*",
      "WebSearch",
      "WebFetch",
      "Bash(echo \"$PDF_FOLDER\")",
      "Bash(echo \"$CLAUDE_VISION_API_KEY\")",
      "Bash(PYTHONPATH=.packages python3 *)",
      "Bash(python3 *)",
      "Bash(pip install *)",
      "Write(/tmp/**)",
      "Bash(mkdir *)",
      "Bash(echo \"$FEED_ID\")",
      "Bash(echo \"$QUEUE_FUNCTION_IDS\")",
      "Bash(echo \"$SAVE_TO_PROJECT_ID\")"
    ],
    "additionalDirectories": [
      "/tmp"
    ]
  }
}
