{
  "disableWorkflows": true,
  "enableAllProjectMcpServers": true,
  "enabledMcpjsonServers": ["pachinko"],
  "permissions": {
    "allow": [
      "mcp__pachinko__*",
      "Skill(update-config)",
      "Bash(command -v fieldtheory)",
      "Bash(command -v node)",
      "Bash(fieldtheory --version)",
      "Bash(echo \"INSTALLED: $\\(fieldtheory --version 2>/dev/null\\)\")",
      "Bash(echo \"INSTALLED: $\\(fieldtheory --version 2>/dev/null || echo 'version unknown'\\)\")",
      "Bash(npm install:*)",
      "Bash(fieldtheory --help)",
      "Bash(fieldtheory status:*)",
      "Bash(fieldtheory path:*)",
      "Bash(fieldtheory sync:*)",
      "Bash(fieldtheory list:*)",
      "Bash(fieldtheory md:*)",
      "Bash(fieldtheory export:*)",
      "Bash(chmod +x:*)",
      "Bash(.claude/scripts/ft-read-bookmarks.sh)",
      "Bash(.claude/scripts/ft-read-sent.sh)",
      "Bash(.claude/scripts/ft-append-sent.sh:*)",
      "Bash(sed 's/^.*\\\\[$/[/')",
      "WebSearch",
      "WebFetch",
      "Bash(.claude/scripts/read_environment.py)"
    ]
  }
}
