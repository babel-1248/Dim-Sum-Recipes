prefix_rule(
    pattern = ["python3", "./.claude/skills/run/load_filter.py"],
    decision = "allow",
    justification = "Allow the bundled Sync Multiple RSS Feeds filter loader.",
)

prefix_rule(
    pattern = ["python3", "./.claude/skills/run/load_feed_file.py"],
    decision = "allow",
    justification = "Allow the bundled Sync Multiple RSS Feeds feed-file loader.",
)

prefix_rule(
    pattern = ["python3", "./.claude/skills/run/check_feed.py"],
    decision = "allow",
    justification = "Allow the bundled Sync Multiple RSS Feeds feed checker.",
)

prefix_rule(
    pattern = ["python3", "./.claude/skills/run/mark_seen.py"],
    decision = "allow",
    justification = "Allow marking an RSS article as seen after it is filtered out or saved.",
)

prefix_rule(
    pattern = ["python3", "./.claude/skills/run/get_article.py"],
    decision = "allow",
    justification = "Allow the bundled Sync Multiple RSS Feeds article extractor.",
)

prefix_rule(
    pattern = ["python3", "./.claude/skills/run/html_to_markdown.py"],
    decision = "allow",
    justification = "Allow the bundled Sync Multiple RSS Feeds markdown converter.",
)

prefix_rule(
    pattern = ["python3", "./.claude/skills/run/parse_feed.py"],
    decision = "allow",
    justification = "Allow the bundled Sync Multiple RSS Feeds feed parser.",
)

prefix_rule(
    pattern = [".claude/scripts/read_environment.py"],
    decision = "allow",
    justification = "Allow reading the Pachinko routing environment configuration as JSON.",
)
